# When running outside Docker, set this to your Mattermost instance URL.
# In Docker (docker-compose), MATTERMOST_URL is set automatically to http://mattermost:8065.
MATTERMOST_URL=http://localhost:8065

# Create a bot account in Mattermost: System Console > Integrations > Bot Accounts
# Then generate a token for the bot and paste it here.
MATTERMOST_TOKEN=your_bot_token_here

# Comma-separated channel IDs to monitor.
# Find a channel ID via: Admin > Channels > click channel > copy ID from URL.
MATTERMOST_CHANNEL_IDS=channel_id_1,channel_id_2
